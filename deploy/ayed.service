[Unit]
Description=Passkey-signed remote approvals
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/ayed
# AYE_HOST (root-only file)
EnvironmentFile=/etc/aye/ayed.env
Restart=on-failure

# Its own throwaway user; passkeys.json, push.json and vapid.key live in
# /var/lib/private/aye, readable only by that user.
DynamicUser=yes
StateDirectory=aye
StateDirectoryMode=0700
# /run/aye holds control.sock for `sudo aye ...` (root only: mode 0600 and a
# check of who is calling) and ask.sock, where `aye` asks for approvals. Any
# user may reach ask.sock, so the directory is 0755, but only this service
# can write to it, and systemd removes it when the service stops: nothing
# else can put a socket there and answer sudo in ayed's place.
RuntimeDirectory=aye
RuntimeDirectoryMode=0755
MemoryMax=512M
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
